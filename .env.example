# Local development
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3001/admin?store=store

# On Vercel, NEXT_PUBLIC_API_URL can be set to the production API URL.
# The app also falls back to the production backend automatically.
# Set NEXT_PUBLIC_ADMIN_DASHBOARD_URL to your deployed admin app URL before
# using admin sign-in on the live storefront.
