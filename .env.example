# Local (Storefront = Sab Pehno on :3000, shared dashboard on :3001)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_STORE_SLUG=store
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3001/admin?store=store

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
NEXT_PUBLIC_CLOUDINARY_FOLDER=store/products

# ── Vercel (Store project) — Settings → Environment Variables → Redeploy ──
# NEXT_PUBLIC_* values are baked in at BUILD time — change + Redeploy required.
#
# NEXT_PUBLIC_API_URL=https://e-commerce-backend-sigma-rose.vercel.app/api/v1
# NEXT_PUBLIC_STORE_SLUG=store
# NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://e-commerce-steel-psi.vercel.app/admin?store=store
#
# Login from Store always opens Sab Pehno admin (?store=store) — code forces the slug.
# Redeploy after changing NEXT_PUBLIC_*.
# See ../shared/ADMIN.md
